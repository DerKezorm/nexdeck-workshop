        "header": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,59}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "name": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.-]{1,80}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "param": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.-]{1,60}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Param"
        }
      },
      "required": [
        "as"
      ],
      "title": "PassOn",
      "type": "object"
    },
    "Read": {
      "additionalProperties": false,
      "description": "One thing worth asking of the service, offered in the step that picks the data of a card.",
      "properties": {
        "path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "path",
        "label"
      ],
      "title": "Read",
      "type": "object"
    },
    "TicketAt": {
      "additionalProperties": false,
      "description": "Where the ticket of a sign-in is: a value of the JSON answer (``at`` is a JMESPath) or a cookie.",
      "properties": {
        "from": {
          "enum": [
            "json",
            "cookie"
          ],
          "title": "From",
          "type": "string"
        },
        "at": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At"
        },
        "name": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.-]{1,80}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "required": [
        "from"
      ],
      "title": "TicketAt",
      "type": "object"
    },
    "VersionRead": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "at": {
          "maxLength": 200,
          "minLength": 1,
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "path",
        "at"
      ],
      "title": "VersionRead",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An own connection, as written.",
  "properties": {
    "nexdeck": {
      "const": "integration",
      "title": "Nexdeck",
      "type": "string"
    },
    "short": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$",
      "title": "Short",
      "type": "string"
    },
    "name": {
      "maxLength": 60,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "logo": {
      "default": "",
      "title": "Logo",
      "type": "string"
    },
    "description": {
      "default": "",
      "maxLength": 300,
      "title": "Description",
      "type": "string"
    },
    "category": {
      "default": "other",
      "pattern": "^[a-z]{3,20}$",
      "title": "Category",
      "type": "string"
    },
    "fields": {
      "items": {
