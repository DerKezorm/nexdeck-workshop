{
  "$defs": {
    "Auth": {
      "additionalProperties": false,
      "description": "How a request proves who asks.",
      "properties": {
        "type": {
          "default": "none",
          "enum": [
            "none",
            "header",
            "basic",
            "query",
            "session"
          ],
          "title": "Type",
          "type": "string"
        },
        "header": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,59}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "user": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User"
        },
        "password": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Password"
        },
        "param": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.-]{1,60}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Param"
        },
        "login": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Login"
        },
        "send": {
          "anyOf": [
            {
              "enum": [
                "json",
                "form"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Send"
        },
        "body": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body"
        },
        "ticket": {
          "anyOf": [
            {
              "$ref": "#/$defs/TicketAt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pass": {
          "anyOf": [
            {
              "$ref": "#/$defs/PassOn"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Auth",
      "type": "object"
    },
    "DefinedField": {
      "additionalProperties": false,
      "description": "One thing asked when a connection of this kind is set up (the address is always asked first).",
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "default": "text",
          "enum": [
            "text",
            "secret",
            "number",
            "switch"
          ],
          "title": "Type",
          "type": "string"
        },
        "label": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "help": {
          "default": "",
          "maxLength": 300,
          "title": "Help",
          "type": "string"
        },
        "placeholder": {
          "default": "",
          "maxLength": 100,
          "title": "Placeholder",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        }
      },
      "required": [
        "name",
        "label"
      ],
      "title": "DefinedField",
      "type": "object"
    },
    "PassOn": {
